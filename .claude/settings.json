{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*test*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-test.sh",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking site reachability before running tests..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
